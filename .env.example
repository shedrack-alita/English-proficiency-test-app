# Copy to .env.local for local overrides. On Netlify, set these under
# Site configuration > Environment variables.

# Hosted database (Turso). Leave unset locally to use a SQLite file in data/.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Long random string used to sign login cookies (required when hosted).
EPT_SECRET=
