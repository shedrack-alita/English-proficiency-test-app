# Copy to .env.local for local overrides. On Vercel, set these under
# Project Settings > Environment Variables.

# Hosted database: your Neon (Postgres) connection string. Leave unset locally to use
# PGlite, a local Postgres stored in data/pglite.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login cookies (required when hosted).
EPT_SECRET=

# Initial admin password, used when the database is first set up (default admin123).
EPT_ADMIN_PASSWORD=
